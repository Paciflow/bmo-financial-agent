# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_INTERPRETATION_MODEL=claude-sonnet-5-5

# --- AWS (S3 storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Qdrant (embedded local mode, no server required) ---
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_SECTIONS_COLLECTION=bmo_sections
QDRANT_CHUNKS_COLLECTION=bmo_chunks

# --- BM25 ---
BM25_INDEX_PATH=./data/bm25

# --- Document source ---
BMO_PDF_URL=https://www.bmo.com/ir/archive/en/bmo_ar2025_MDA.pdf
DOCUMENT_ID=bmo_ar2025_mda

# --- Retrieval ---
DENSE_TOP_K=30
BM25_TOP_K=30
RRF_K=60
RERANK_TOP_K=20
EVIDENCE_TOP_K=10

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
